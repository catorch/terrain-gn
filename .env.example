NODE_ENV=development
PORT=4100
DATABASE_URL=postgresql://terrain:terrain@localhost:5435/terrain
JWT_SECRET=change-me-to-32-plus-random-bytes-in-production
ADMIN_API_KEY=change-me-admin-key-for-retool
PUBLIC_API_URL=http://localhost:4100

# Twilio Verify (OTP). Leave empty outside production to accept code 000000.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

# S3 / DigitalOcean Spaces (private bucket). Local values point at s3mock.
S3_ENDPOINT=http://localhost:9190
S3_REGION=us-east-1
S3_BUCKET=terrain-docs
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_FORCE_PATH_STYLE=true

# CinetPay (Phase 2). sk_test_ keys use the sandbox base URL.
CINETPAY_BASE_URL=https://api.cinetpay.net
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
CINETPAY_MAX_AMOUNT_GNF=1500000
PLATFORM_FEE_BPS=300
